# Copy this file to .env and fill in what you need. Everything is optional;
# paper-scout runs with an empty .env. .env is gitignored.

# Semantic Scholar API key (free): https://www.semanticscholar.org/product/api
# Without one you're limited to ~100 requests per 5 minutes.
SEMANTIC_SCHOLAR_KEY=

# OpenAlex API key (optional): https://openalex.org
OPENALEX_KEY=

# Contact email for Unpaywall's open-access PDF lookups (no signup, no key):
# https://unpaywall.org/products/api . Also used for OpenAlex's "polite pool".
UNPAYWALL_EMAIL=

# Local Ollama model for --evidence-cards / --draft-hypothesis.
# Install Ollama (https://ollama.com), then: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct

# Research profile used for routing. Defaults to profiles/example_profile.json.
# Put your own in profiles/private/ (gitignored), e.g.:
#   RESEARCH_PROFILE=profiles/private/my_profile.json
RESEARCH_PROFILE=

# Folder for --save-vault markdown notes. Defaults to results/notes.
# Point it inside an Obsidian vault to have notes land there, e.g.:
#   VAULT_PATH=~/Documents/MyVault/Sources
VAULT_PATH=
